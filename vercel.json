{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/divyaraj-resume.pdf",
      "destination": "/Divyaraj-Resume.pdf"
    }
  ],
  "redirects": [
    {
      "source": "/divyaraj_resume",
      "destination": "/divyaraj-resume",
      "permanent": true
    },
    {
      "source": "/brands/the-last-amber",
      "destination": "/brands/ai-cinema-lab/the-last-amber",
      "permanent": true
    },
    {
      "source": "/brands/the-last-amber/(.*)",
      "destination": "/brands/ai-cinema-lab/the-last-amber/$1",
      "permanent": true
    },
    {
      "source": "/the-last-amber",
      "destination": "/brands/ai-cinema-lab/the-last-amber",
      "permanent": true
    },
    {
      "source": "/the-last-amber/(.*)",
      "destination": "/brands/ai-cinema-lab/the-last-amber/$1",
      "permanent": true
    },
    {
      "source": "/brands/AiCinemaLab/TheLastAmber",
      "destination": "/brands/ai-cinema-lab/the-last-amber",
      "permanent": true
    },
    {
      "source": "/brands/AiCinemaLab/TheLastAmber/(.*)",
      "destination": "/brands/ai-cinema-lab/the-last-amber/$1",
      "permanent": true
    },
    {
      "source": "/brands/Ai%20Cinema%20Lab/The%20Last%20Amber/(.*)",
      "destination": "/brands/ai-cinema-lab/the-last-amber/$1",
      "permanent": true
    },
    {
      "source": "/brands/Ai%20Cinema%20Lab/The%20Last%20Amber",
      "destination": "/brands/ai-cinema-lab/the-last-amber",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*|android-chrome.*|dc-favicon.*|dc-apple-touch-icon.*|dc-android-chrome.*|site.webmanifest|.*share-card.*|.*og-image.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}